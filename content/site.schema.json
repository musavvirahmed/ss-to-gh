{
  "$id": "https://musavvir.info/schemas/site-content.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "location",
    "resume_pdf",
    "avatar",
    "bio",
    "footer_links"
  ],
  "properties": {
    "location": {
      "type": "string",
      "minLength": 1
    },
    "resume_pdf": {
      "type": "string",
      "pattern": "^/s/[\\w.-]+\\.pdf$"
    },
    "avatar": {
      "type": "string",
      "pattern": "^assets/[\\w.-]+$"
    },
    "bio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paragraphs", "highlights"],
      "properties": {
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "highlights": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["phrase", "style"],
            "properties": {
              "phrase": { "type": "string", "minLength": 1 },
              "style": { "type": "string", "enum": ["underline", "scribble"] },
              "bold": { "type": "boolean" },
              "href": { "type": "string", "minLength": 1 },
              "color": { "type": "string", "enum": ["white", "darkAccent"] }
            }
          }
        }
      }
    },
    "footer_links": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "href"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "href": {
            "type": "string",
            "pattern": "^(https://|/)[^\\s]+$"
          }
        }
      }
    }
  }
}
